li.unchecked::marker { content: &quot;\2610&quot;; }
li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Cascadia Code'; font-size:10pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Local Enhancement Parameters: &lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:700;&quot;&gt;   &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:9pt; font-weight:700;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25;&quot;&gt;Local mean intensity m&lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25; vertical-align:sub;&quot;&gt;Sxy&lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25;&quot;&gt;:    &lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#bc6c25;&quot;&gt; k₀·m&lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#bc6c25; vertical-align:sub;&quot;&gt;G&lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#bc6c25;&quot;&gt; ≤ m&lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#bc6c25; vertical-align:sub;&quot;&gt;Sxy&lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#bc6c25;&quot;&gt; ≤ k₁·m&lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#bc6c25; vertical-align:sub;&quot;&gt;G&lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25;&quot;&gt;    &lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25;&quot;&gt;(m&lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25; vertical-align:sub;&quot;&gt;G&lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25;&quot;&gt;: global mean)&lt;br /&gt;(k₀, k₁: constants)&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; font-size:9pt; color:#bc6c25;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25;&quot;&gt;Local standard deviation s&lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25; vertical-align:sub;&quot;&gt;Sxy&lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25;&quot;&gt;:    &lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#bc6c25;&quot;&gt; k₂·s&lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#bc6c25; vertical-align:sub;&quot;&gt;G&lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#bc6c25;&quot;&gt; ≤ s&lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#bc6c25; vertical-align:sub;&quot;&gt;Sxy&lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#bc6c25;&quot;&gt; ≤ k₃·s&lt;/span&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#bc6c25; vertical-align:sub;&quot;&gt;G&lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25;&quot;&gt;    &lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25;&quot;&gt;(s&lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25; vertical-align:sub;&quot;&gt;G&lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25;&quot;&gt;: global standard deviation)&lt;br /&gt;(k₂, k₃: constants)   &lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt;&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt; color:#3c6e71;&quot;&gt;1. If both conditions are met, enhance the pixel intensity:        &lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#3c6e71;&quot;&gt;  g(x, y) = C·f(x, y)&lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#3c6e71;&quot;&gt;        &lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt; color:#3c6e71;&quot;&gt;(C: intensity)&lt;br /&gt;(f(x, y): original pixel value)     &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt; color:#3c6e71;&quot;&gt;2. If the conditions are not met, leave the pixel unchanged:        &lt;/span&gt;&lt;/p&gt;
&lt;p align=&quot;center&quot; style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt; font-weight:700; color:#3c6e71;&quot;&gt;  g(x, y) = f(x, y)&lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#3c6e71;&quot;&gt; &lt;/span&gt;&lt;span style=&quot; font-size:9pt; color:#bc6c25;&quot;&gt;      &lt;/span&gt;&lt;span style=&quot; font-size:9pt;&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-size:9pt; font-weight:700;&quot;&gt;Example Parameters:&lt;/span&gt;&lt;span style=&quot; font-size:9pt;&quot;&gt; k₀ = 0, k₁ = 0.1, k₂ = 0, k₃ = 0.1, C = 22.8    &lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
